@model ServerApp.Models.Item
@{ ViewData["Title"] = "Видалення товару"; }

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Підтвердження видалення</h4>
            </div>
            <div class="card-body">
                <p class="lead text-center">Ви дійсно бажаєте видалити цей товар?</p>
                <dl class="row">
                    <dt class="col-sm-4">ID</dt>
                    <dd class="col-sm-8">@Model.Id</dd>
                    <dt class="col-sm-4">Назва</dt>
                    <dd class="col-sm-8">@Model.Name</dd>
                    <dt class="col-sm-4">Ціна</dt>
                    <dd class="col-sm-8">@Model.Price.ToString("C")</dd>
                </dl>
                <form asp-action="Delete" method="post" class="d-flex justify-content-between mt-4">
                    <input type="hidden" asp-for="Id" />
                    <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
                    <button type="submit" class="btn btn-danger">Так, видалити</button>
                </form>
            </div>
        </div>
    </div>
</div>
