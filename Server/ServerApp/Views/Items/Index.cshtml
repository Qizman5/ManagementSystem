@model IEnumerable<ServerApp.Models.Item>
@{
    ViewData["Title"] = "Складський Облік";
    Layout = null; // Автономний сучасний дизайн
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Панель Управління Складом</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
        body {
            background: #0f172a;
            color: #f8fafc;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
        }
        .navbar-custom {
            background: rgba(30, 41, 59, 0.8);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        .glass-card {
            background: #1e293b;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }
        .table-dark-custom {
            --bs-table-bg: transparent;
            --bs-table-color: #cbd5e1;
            --bs-table-hover-bg: rgba(255, 255, 255, 0.03);
            border-color: rgba(255, 255, 255, 0.08);
        }
        .badge-quantity {
            background: rgba(59, 130, 246, 0.15);
            color: #60a5fa;
            border: 1px solid rgba(59, 130, 246, 0.3);
        }
        .badge-discount {
            background: rgba(239, 68, 68, 0.15);
            color: #f87171;
            border: 1px solid rgba(239, 68, 68, 0.3);
        }
        .price-old {
            text-decoration: line-through;
            color: #64748b;
            font-size: 0.9em;
        }
        .price-final {
            color: #34d399;
            font-weight: 700;
        }
        .btn-neon {
            background: #3b82f6;
            color: #ffffff;
            border: none;
            box-shadow: 0 4px 14px rgba(59, 130, 246, 0.4);
            transition: all 0.2s ease;
        }
        .btn-neon:hover {
            background: #2563eb;
            color: #ffffff;
            transform: translateY(-1px);
        }
    </style>
</head>
<body>

    <!-- Верхня навігаційна панель -->
    <nav class="navbar navbar-dark navbar-custom sticky-top py-3 mb-4">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold fs-4" href="#">
                <i class="bi bi-box-seam-fill text-primary"></i>
                <span>Warehouse<span class="text-primary">Pro</span></span>
            </a>
            <div class="d-flex align-items-center gap-3">
                <span class="text-muted small d-none d-sm-inline">
                    <i class="bi bi-person-circle me-1"></i> @User.Identity?.Name
                </span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-semibold">
                        <i class="bi bi-box-arrow-right me-1"></i> Вийти
                    </button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container mb-5">
        <!-- Шапка сторінки та дії -->
        <div class="glass-card p-4 mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h3 class="fw-bold mb-1"><i class="bi bi-boxes text-primary me-2"></i>Управління Товарами</h3>
                <p class="text-muted small mb-0">Перегляд, редагування цін, знижок та кількості товарів на складі</p>
            </div>
            <div class="d-flex gap-2">
                <a href="/Admin/CreateProduct" class="btn btn-neon fw-semibold px-4 py-2 rounded-3">
                    <i class="bi bi-plus-lg me-1"></i> Додати товар
                </a>
            </div>
        </div>

        <!-- Таблиця товарів -->
        <div class="glass-card overflow-hidden">
            <div class="table-responsive">
                <table class="table table-dark-custom align-middle mb-0">
                    <thead>
                        <tr class="text-uppercase small fw-bold text-muted border-bottom border-secondary border-opacity-25">
                            <th class="ps-4 py-3">ID</th>
                            <th class="py-3">Назва товару</th>
                            <th class="py-3">Кількість</th>
                            <th class="py-3">Базова ціна</th>
                            <th class="py-3">Знижка</th>
                            <th class="py-3">Кінцева ціна</th>
                            <th class="text-end pe-4 py-3">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-muted">#@item.Id</td>
                                    <td>
                                        <span class="fw-bold text-white fs-6">@item.Name</span>
                                    </td>
                                    <td>
                                        <span class="badge badge-quantity rounded-pill px-3 py-2 fw-semibold">
                                            <i class="bi bi-layers me-1"></i>@item.Quantity шт.
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.Discount > 0)
                                        {
                                            <span class="price-old">@item.Price.ToString("N2") ₴</span>
                                        }
                                        else
                                        {
                                            <span class="text-slate-300">@item.Price.ToString("N2") ₴</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.Discount > 0)
                                        {
                                            <span class="badge badge-discount rounded-pill px-2.5 py-1.5 fw-bold">
                                                -@item.Discount%
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">0%</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="price-final fs-6">
                                            @item.FinalPrice.ToString("N2") ₴
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a href="/Admin/Edit/@item.Id" class="btn btn-sm btn-outline-warning rounded-2 me-1 px-3">
                                            <i class="bi bi-pencil me-1"></i>Редагувати
                                        </a>
                                        <a href="/Admin/Delete/@item.Id" class="btn btn-sm btn-outline-danger rounded-2 px-3">
                                            <i class="bi bi-trash me-1"></i>Видалити
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                    Товари відсутні у базі даних
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
