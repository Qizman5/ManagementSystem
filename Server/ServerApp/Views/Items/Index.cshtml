@model IEnumerable<ServerApp.Models.Item>
@{
    ViewData["Title"] = "Каталог товарів";
    Layout = null;
    int index = 1;
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Товари - WMS System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <style>
        :root {
            --bg-main: #0b0f19;
            --card-bg: #131b2e;
            --card-border: rgba(255, 255, 255, 0.08);
            --accent-blue: #3b82f6;
        }

        body {
            background-color: var(--bg-main);
            color: #f1f5f9;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
        }

        .navbar-custom {
            background: rgba(11, 15, 25, 0.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--card-border);
        }

        .glass-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 16px;
            padding: 1.75rem;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        }

        .table-custom {
            --bs-table-bg: transparent;
            --bs-table-color: #cbd5e1;
            margin-bottom: 0;
            border-color: var(--card-border);
        }

        .table-custom th {
            background-color: rgba(255, 255, 255, 0.03);
            color: #94a3b8;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 0.85rem 1rem;
        }

        .table-custom td {
            padding: 0.9rem 1rem;
            vertical-align: middle;
            background-color: transparent !important;
            color: #f1f5f9;
        }

        .badge-count {
            background: rgba(255, 255, 255, 0.08);
            color: #94a3b8;
            font-size: 0.8rem;
            padding: 0.35rem 0.75rem;
            border-radius: 20px;
        }
    </style>
</head>
<body>

    <!-- Навігаційна панель -->
    <nav class="navbar navbar-dark navbar-custom px-4 py-2 mb-4">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-white fs-5" href="/Items">
                <i class="bi bi-box-seam text-primary"></i>
                <span>WMS <span class="text-secondary fw-normal">Склад</span></span>
            </a>
            <div class="d-flex align-items-center gap-2">
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-2 px-3">
                        <i class="bi bi-box-arrow-right me-1"></i> Вийти
                    </button>
                </form>
            </div>
        </div>
    </nav>

    <!-- Основний контент -->
    <main class="container-fluid px-4">
        <div class="glass-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold mb-0 d-flex align-items-center gap-2 text-white">
                    <i class="bi bi-boxes text-primary"></i> Список товарів на складі
                </h3>
                <span class="badge badge-count">Всього: @(Model?.Count() ?? 0)</span>
            </div>

            <div class="table-responsive rounded-3">
                <table class="table table-custom align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>НАЗВА ТОВАРУ</th>
                            <th>КІЛЬКІСТЬ</th>
                            <th>БАЗОВА ЦІНА</th>
                            <th>ЗНИЖКА / НАЦІНКА</th>
                            <th>КІНЦЕВА ЦІНА</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                var finalPrice = item.Price * (1 + (item.Discount / 100m));
                                <tr>
                                    <!-- Послідовна нумерація 1, 2, 3... без знака # -->
                                    <td class="text-secondary fw-bold">@(index++)</td>
                                    <td class="fw-semibold text-white">
                                        <i class="bi bi-box text-secondary me-1"></i> @item.Name
                                    </td>
                                    <td>
                                        <span class="badge bg-dark border border-secondary text-light px-2.5 py-1.5">
                                            @item.Quantity шт.
                                        </span>
                                    </td>
                                    <td class="text-light">
                                        @item.Price.ToString("N2") ₴
                                    </td>
                                    <td>
                                        @if (item.Discount < 0)
                                        {
                                            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 px-2 py-1 rounded-pill">
                                                @item.Discount%
                                            </span>
                                        }
                                        else if (item.Discount > 0)
                                        {
                                            <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-25 px-2 py-1 rounded-pill">
                                                +@item.Discount%
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0%</span>
                                        }
                                    </td>
                                    <td class="text-info fw-bold">
                                        @finalPrice.ToString("N2") ₴
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-2 d-block mb-2 opacity-50"></i>
                                    <span>Товари відсутні у системі</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>

</body>
</html>
