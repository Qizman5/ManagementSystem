@model ServerApp.Models.Item
@{
    ViewData["Title"] = "Створення товару";
    Layout = null; // Автономний сучасний дизайн
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Додати товар - Warehouse System</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
        body {
            background: #0f172a;
            color: #f8fafc;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .glass-card {
            background: #1e293b;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
            width: 100%;
            max-width: 560px;
        }
        .form-control {
            background-color: #0f172a;
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #f8fafc;
        }
        .form-control:focus {
            background-color: #0f172a;
            color: #ffffff;
            border-color: #3b82f6;
            box-shadow: 0 0 0 0.25rem rgba(59, 130, 246, 0.2);
        }
        .input-group-text {
            background-color: #1e293b;
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #94a3b8;
        }
    </style>
</head>
<body>

<div class="container p-3 my-4">
    <div class="glass-card mx-auto p-4 p-sm-5">
        <div class="text-center mb-4">
            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex p-3 mb-2">
                <i class="bi bi-box-seam fs-2"></i>
            </div>
            <h3 class="fw-bold text-white mb-1">Додавання товару</h3>
            <p class="text-muted small">Введіть параметри нового товару для складу</p>
        </div>

        <form asp-controller="Items" asp-action="Create" method="post" autocomplete="off">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <!-- Назва товару -->
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold text-slate-300 small">Назва товару</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-tag"></i></span>
                    <input asp-for="Name" class="form-control" placeholder="Наприклад: Миша Бездротова" required autofocus />
                </div>
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <!-- Опис товару -->
            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold text-slate-300 small">Опис (необов'язково)</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-card-text"></i></span>
                    <textarea asp-for="Description" class="form-control" rows="3" style="resize: none;" placeholder="Короткий опис товару..."></textarea>
                </div>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <!-- Кількість та Базова ціна -->
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Quantity" class="form-label fw-semibold text-slate-300 small">Кількість (шт.)</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-layers"></i></span>
                        <input asp-for="Quantity" type="number" min="0" class="form-control" placeholder="0" required />
                    </div>
                    <span asp-validation-for="Quantity" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Price" class="form-label fw-semibold text-slate-300 small">Базова ціна (₴)</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-currency-dollar"></i></span>
                        <input asp-for="Price" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00" required />
                    </div>
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>
            </div>

            <!-- Знижка -->
            <div class="mb-4">
                <label asp-for="Discount" class="form-label fw-semibold text-slate-300 small">Знижка (%)</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-percent"></i></span>
                    <input asp-for="Discount" type="number" min="0" max="100" class="form-control" placeholder="0" />
                </div>
                <span asp-validation-for="Discount" class="text-danger small"></span>
            </div>

            <!-- Кнопки дій -->
            <div class="d-flex gap-2 pt-2">
                <a asp-action="Index" class="btn btn-outline-secondary w-50 fw-semibold rounded-3 py-2">
                    <i class="bi bi-arrow-left me-1"></i> Скасувати
                </a>
                <button type="submit" class="btn btn-primary w-50 fw-bold rounded-3 py-2 shadow-sm">
                    <i class="bi bi-check-lg me-1"></i> Зберегти
                </button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
