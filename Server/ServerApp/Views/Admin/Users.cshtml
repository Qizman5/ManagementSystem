@model IEnumerable<ServerApp.Models.Worker>
@{
    ViewData["Title"] = "Користувачі";
}

<div class="container mt-4">
    <h2>Список користувачів системи</h2>
    <table class="table table-striped table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Ім'я</th>
                <th>Логін / Email</th>
                <th>Роль</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var worker in Model)
                {
                    <tr>
                        <td>@worker.Id</td>
                        <td>@(worker.Name ?? "—")</td>
                        <td>@(worker.Email ?? worker.Username ?? "—")</td>
                        <td>
                            <span class="badge @(worker.Role == "Admin" ? "bg-danger" : "bg-primary")">
                                @(worker.Role ?? "User")
                            </span>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">Користувачі відсутні</td>
                </tr>
            }
        </tbody>
    </table>
</div>
