@model IEnumerable<ServerApp.Models.Worker>
@{
    ViewData["Title"] = "Користувачі";
}

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h4 class="mb-0 fw-bold text-dark"><i class="bi bi-people text-primary me-2"></i>Список користувачів системи</h4>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Ім'я</th>
                        <th>Логін / Email</th>
                        <th class="text-center">Роль</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var worker in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-muted">#@worker.Id</td>
                                <td class="fw-semibold">@(worker.Name ?? "—")</td>
                                <td><i class="bi bi-envelope text-muted me-2"></i>@(worker.Email ?? worker.Username ?? "—")</td>
                                <td class="text-center">
                                    @if (worker.Role == "Admin")
                                    {
                                        <span class="badge bg-danger rounded-pill px-3 py-2"><i class="bi bi-shield-check me-1"></i>Admin</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary rounded-pill px-3 py-2"><i class="bi bi-person me-1"></i>Worker</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                <i class="bi bi-folder2-open display-6 mb-2 d-block"></i>Користувачів не знайдено
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
