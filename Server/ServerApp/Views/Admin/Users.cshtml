@model IEnumerable<ServerApp.Models.Worker>
@{
    ViewData["Title"] = "Список користувачів";
    Layout = null;
    int index = 1;
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Користувачі - AdminConsole</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <style>
        :root {
            --bg-main: #0b0f19;
            --card-bg: #131b2e;
            --card-border: rgba(255, 255, 255, 0.08);
            --accent-blue: #3b82f6;
            --text-muted: #64748b;
        }

        body {
            background-color: var(--bg-main);
            color: #f1f5f9;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
        }

        .navbar-custom {
            background: rgba(11, 15, 25, 0.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--card-border);
        }

        .glass-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 16px;
            padding: 1.5rem;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.37);
        }

        .table-responsive {
            border-radius: 12px;
            overflow: hidden;
        }

        .table-custom {
            --bs-table-bg: transparent;
            --bs-table-color: #cbd5e1;
            margin-bottom: 0;
            border-color: var(--card-border);
        }

        .table-custom th {
            background-color: rgba(255, 255, 255, 0.04);
            color: #94a3b8;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 1rem;
        }

        .table-custom td {
            padding: 1rem;
            vertical-align: middle;
            background-color: transparent !important;
            color: #f1f5f9;
        }

        .badge-role-admin {
            background: rgba(239, 68, 68, 0.15);
            color: #f87171;
            border: 1px solid rgba(239, 68, 68, 0.3);
            font-weight: 600;
            padding: 0.35em 0.8em;
            border-radius: 20px;
        }

        .badge-role-worker {
            background: rgba(59, 130, 246, 0.15);
            color: #60a5fa;
            border: 1px solid rgba(59, 130, 246, 0.3);
            font-weight: 600;
            padding: 0.35em 0.8em;
            border-radius: 20px;
        }
    </style>
</head>
<body>

    <!-- Навігація -->
    <nav class="navbar navbar-dark navbar-custom px-3 py-2 mb-4">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-white fs-5" href="/Admin">
                <i class="bi bi-shield-check text-primary"></i>
                <span>Admin <span class="text-secondary fw-normal">Console</span></span>
            </a>
            <a href="/Admin" class="btn btn-outline-light btn-sm rounded-2 px-3">
                <i class="bi bi-arrow-left me-1"></i> Назад до панелі
            </a>
        </div>
    </nav>

    <main class="container px-3 px-md-4">
        <div class="glass-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-people text-primary"></i> Список користувачів системи
                </h4>
                <span class="badge bg-secondary bg-opacity-25 text-light px-3 py-2 rounded-pill">
                    Всього: @(Model?.Count() ?? 0)
                </span>
            </div>

            <div class="table-responsive">
                <table class="table table-custom align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Ім'я</th>
                            <th>Логін / Email</th>
                            <th>Роль</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td class="text-secondary fw-bold">#@(index++)</td>
                                    <td class="fw-semibold">
                                        <i class="bi bi-person-circle me-2 text-secondary"></i>@(string.IsNullOrEmpty(user.Name) ? user.Username : user.Name)
                                    </td>
                                    <td>@user.Email</td>
                                    <td>
                                        @if (user.Role?.ToLower() == "admin")
                                        {
                                            <span class="badge badge-role-admin">
                                                <i class="bi bi-shield-lock me-1"></i>Admin
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-role-worker">
                                                <i class="bi bi-person me-1"></i>Worker
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="bi bi-people fs-2 d-block mb-2 opacity-50"></i>
                                    Користувачі відсутні у базі даних
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>

</body>
</html>
