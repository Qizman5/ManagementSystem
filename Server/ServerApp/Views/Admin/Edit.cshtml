@model ServerApp.Models.Item
@{
    ViewData["Title"] = "Редагування товару";
    Layout = null;
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Редагування товару - AdminConsole</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
        :root {
            --bg-dark: #0b0f19;
            --card-bg: #151c2c;
            --border-color: rgba(255, 255, 255, 0.08);
            --accent-purple: #8b5cf6;
            --accent-blue: #3b82f6;
            --accent-orange: #f59e0b;
        }

        body {
            background-color: var(--bg-dark);
            color: #f1f5f9;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
        }

        .stat-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        }

        .form-control {
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-color);
            color: #f1f5f9;
            border-top-right-radius: 8px;
            border-bottom-right-radius: 8px;
        }

        .form-control:focus {
            background-color: rgba(255, 255, 255, 0.08);
            border-color: var(--accent-orange);
            color: #fff;
            box-shadow: 0 0 0 0.25rem rgba(245, 158, 11, 0.2);
        }

        .input-group-text {
            background-color: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border-color);
            border-right: none;
            color: #94a3b8;
            border-top-left-radius: 8px;
            border-bottom-left-radius: 8px;
        }

        .btn-warning-custom {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            border: none;
            color: #0f172a;
            box-shadow: 0 4px 15px rgba(245, 158, 11, 0.25);
            transition: all 0.2s ease;
        }

        .btn-warning-custom:hover {
            color: #000;
            opacity: 0.95;
            transform: translateY(-1px);
        }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center py-5">
    <div class="container" style="max-width: 550px;">
        <div class="stat-card p-4 p-md-5">
            
            <!-- Заголовок -->
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning fs-3">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0 text-white">Редагування товару</h3>
                    <p class="text-muted small mb-0">Зміна параметрів товару <span class="text-warning fw-bold">#@Model.Id</span></p>
                </div>
            </div>

            <!-- Форма -->
            <form asp-controller="Admin" asp-action="Edit" method="post" autocomplete="off">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <!-- Назва товару -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label text-muted small fw-semibold">Назва товару</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-tag"></i></span>
                        <input asp-for="Name" class="form-control py-2" required />
                    </div>
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <!-- Кількість та Ціна -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Quantity" class="form-label text-muted small fw-semibold">Кількість (шт.)</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-layers"></i></span>
                            <input asp-for="Quantity" type="number" min="0" class="form-control py-2" required />
                        </div>
                        <span asp-validation-for="Quantity" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label text-muted small fw-semibold">Базова ціна (₴)</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-currency-dollar"></i></span>
                            <input asp-for="Price" type="number" step="0.01" min="0.01" class="form-control py-2" required />
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Знижка -->
                <div class="mb-4">
                    <label asp-for="Discount" class="form-label text-muted small fw-semibold">Знижка (%)</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-percent"></i></span>
                        <input asp-for="Discount" type="number" step="0.01" min="0" max="100" class="form-control py-2" />
                    </div>
                    <span asp-validation-for="Discount" class="text-danger small"></span>
                </div>

                <!-- Кнопки дій -->
                <div class="d-flex justify-content-end gap-2 pt-2">
                    <a href="/Admin/Index" class="btn btn-outline-secondary rounded-3 px-4 fw-semibold">Скасувати</a>
                    <button type="submit" class="btn btn-warning-custom rounded-3 px-4 fw-bold">
                        <i class="bi bi-save me-1"></i> Оновити
                    </button>
                </div>
            </form>

        </div>
    </div>
</body>
</html>
