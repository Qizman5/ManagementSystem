@model ServerApp.Models.Item
@{
    ViewData["Title"] = "Редагування товару";
    Layout = null; // Автономний сучасний дизайн
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Редагування товару - Warehouse System</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
        body {
            background: #0f172a;
            color: #f8fafc;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .glass-card {
            background: #1e293b;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
            width: 100%;
            max-width: 520px;
        }
        .form-control {
            background-color: #0f172a;
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #f8fafc;
        }
        .form-control:focus {
            background-color: #0f172a;
            color: #ffffff;
            border-color: #f59e0b;
            box-shadow: 0 0 0 0.25rem rgba(245, 158, 11, 0.2);
        }
        .input-group-text {
            background-color: #1e293b;
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #94a3b8;
        }
    </style>
</head>
<body>

<div class="container p-3">
    <div class="glass-card mx-auto p-4 p-sm-5">
        <div class="text-center mb-4">
            <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-inline-flex p-3 mb-2">
                <i class="bi bi-pencil-square fs-2"></i>
            </div>
            <h3 class="fw-bold text-white mb-1">Редагування товару</h3>
            <p class="text-muted small">Товар ID: <span class="text-warning fw-bold">#@Model.Id</span></p>
        </div>

        <form asp-action="Edit" method="post" autocomplete="off">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold text-slate-300 small">Назва товару</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-tag"></i></span>
                    <input asp-for="Name" class="form-control" required />
                </div>
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Quantity" class="form-label fw-semibold text-slate-300 small">Кількість (шт.)</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-layers"></i></span>
                        <input asp-for="Quantity" type="number" min="0" class="form-control" required />
                    </div>
                    <span asp-validation-for="Quantity" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Price" class="form-label fw-semibold text-slate-300 small">Базова ціна (₴)</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-currency-dollar"></i></span>
                        <input asp-for="Price" type="number" step="0.01" min="0.01" class="form-control" required />
                    </div>
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Discount" class="form-label fw-semibold text-slate-300 small">Знижка (%)</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-percent"></i></span>
                    <input asp-for="Discount" type="number" min="0" max="100" class="form-control" placeholder="0" />
                </div>
                <span asp-validation-for="Discount" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2 pt-2">
                <a href="/Items" class="btn btn-outline-secondary w-50 fw-semibold rounded-3 py-2">Скасувати</a>
                <button type="submit" class="btn btn-warning w-50 fw-bold text-dark rounded-3 py-2 shadow-sm">
                    <i class="bi bi-save me-1"></i> Зберегти
                </button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
