@model ServerApp.Models.Item
@{
    ViewData["Title"] = "Видалення товару";
    Layout = null;
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Видалити товар - Warehouse System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
        body {
            background: #0f172a;
            color: #f8fafc;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .glass-card {
            background: #1e293b;
            border: 1px solid rgba(239, 68, 68, 0.2);
            border-radius: 16px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
            width: 100%;
            max-width: 460px;
        }
        .info-box {
            background-color: #0f172a;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }
    </style>
</head>
<body>

<div class="container p-3">
    <div class="glass-card mx-auto p-4 p-sm-5 text-center">
        <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-inline-flex p-3 mb-3">
            <i class="bi bi-exclamation-triangle-fill fs-1"></i>
        </div>
        <h3 class="fw-bold text-white mb-2">Видалити товар?</h3>
        <p class="text-muted small mb-4">Ця дія є незворотною. Товар буде повністю вилучено з бази даних.</p>

        <div class="info-box p-3 text-start mb-4">
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted small">Назва:</span>
                <span class="fw-bold text-white">@Model.Name</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted small">Залишок:</span>
                <span class="fw-semibold text-info">@Model.Quantity шт.</span>
            </div>
            <div class="d-flex justify-content-between">
                <span class="text-muted small">Кінцева ціна:</span>
                <span class="fw-bold text-success">@Model.FinalPrice.ToString("N2") ₴</span>
            </div>
        </div>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <a href="/Items" class="btn btn-outline-secondary w-50 fw-semibold rounded-3 py-2">Скасувати</a>
                <button type="submit" class="btn btn-danger w-50 fw-bold rounded-3 py-2 shadow-sm">
                    <i class="bi bi-trash me-1"></i> Видалити
                </button>
            </div>
        </form>
    </div>
</div>

</body>
</html>
