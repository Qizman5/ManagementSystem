@{
    ViewData["Title"] = "Дашборд Адміністратора";
}

<!-- Заголовок адмінки -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-shield-lock text-primary me-2"></i>Панель Управління Проєктом</h2>
        <p class="text-muted mb-0">Огляд стану систем ServerApp та ClientApp</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Items" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-box-seam me-1"></i> До товарів
        </a>
        <button class="btn btn-purple" onclick="location.reload();">
            <i class="bi bi-arrow-clockwise me-1"></i> Оновити
        </button>
    </div>
</div>

<!-- Метрики та Статуси Модулів -->
<div class="row g-3 mb-4">
    <!-- ServerApp Status -->
    <div class="col-md-3">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary fs-3">
                    <i class="bi bi-server"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">Модуль Server</span>
                    <span class="fw-bold text-dark fs-5">ServerApp</span>
                    <div class="mt-1">
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">
                            <i class="bi bi-circle-fill me-1 small"></i> @ViewBag.ServerStatus
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ClientApp Status -->
    <div class="col-md-3">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-info bg-opacity-10 p-3 text-info fs-3">
                    <i class="bi bi-laptop"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">Модуль Client</span>
                    <span class="fw-bold text-dark fs-5">ClientApp</span>
                    <div class="mt-1">
                        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill">
                            <i class="bi bi-circle-fill me-1 small"></i> @ViewBag.ClientStatus
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Використання пам'яті -->
    <div class="col-md-3">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning fs-3">
                    <i class="bi bi-cpu"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">ОЗП Сервера</span>
                    <span class="fw-bold text-dark fs-5">@ViewBag.ProcessMemory</span>
                    <div class="text-muted small mt-1">ОС: @ViewBag.OsVersion</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Час роботи сервера -->
    <div class="col-md-3">
        <div class="card h-100 border-0 shadow-sm p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success fs-3">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">Uptime Сервера</span>
                    <span class="fw-bold text-dark fs-5">@ViewBag.Uptime</span>
                    <div class="text-muted small mt-1">Стабільне з'єднання</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Розділи управління модулями -->
<div class="row g-4 mb-4">
    <!-- Управління ServerApp -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-primary"><i class="bi bi-hdd-network me-2"></i>ServerApp (Бекенд та База)</h5>
                <span class="badge bg-light text-dark border">SQLite / EntityFramework</span>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">Швидкий доступ до баз даних, користувачів та операцій складського обліку.</p>
                <div class="d-grid gap-2">
                    <a asp-controller="Items" asp-action="Index" class="btn btn-outline-primary text-start d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-boxes me-2"></i> Управління Товарами (Items)</span>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                    <a asp-controller="Users" asp-action="Index" class="btn btn-outline-primary text-start d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-people me-2"></i> Користувачі та Ролі (Users)</span>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                    <a asp-controller="UserActions" asp-action="Index" class="btn btn-outline-primary text-start d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-journal-text me-2"></i> Логи Операцій (UserActions)</span>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Управління ClientApp -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-info"><i class="bi bi-window-desktop me-2"></i>ClientApp (Клієнтський Додаток)</h5>
                <span class="badge bg-light text-dark border">Frontend / Desktop App</span>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">Налаштування зв'язку та API ендпоінтів для клієнтських терміналів.</p>
                <div class="p-3 bg-light rounded-3 mb-3 border">
                    <div class="d-flex justify-content-between text-muted small mb-1">
                        <span>API Base URL:</span>
                        <code class="text-primary">http://localhost:5024/api/</code>
                    </div>
                    <div class="d-flex justify-content-between text-muted small">
                        <span>Формат даних:</span>
                        <span class="fw-semibold">JSON (REST API)</span>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a href="/swagger" target="_blank" class="btn btn-outline-info flex-grow-1">
                        <i class="bi bi-code-slash me-1"></i> Swagger API
                    </a>
                    <a href="#" class="btn btn-outline-secondary flex-grow-1" onclick="alert('ClientApp з\'єднано успішно!')">
                        <i class="bi bi-wifi me-1"></i> Тест Зв'язку
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>