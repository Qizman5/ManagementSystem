@model IEnumerable<ServerApp.Models.Item>
@{
    ViewData["Title"] = "Панель Управління Проєктом";
    Layout = null;
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no" />
    <title>AdminConsole - Панель Управління</title>
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <style>
        :root {
            --bg-dark: #0b0f19;
            --card-bg: #151c2c;
            --border-color: rgba(255, 255, 255, 0.08);
            --accent-purple: #8b5cf6;
            --accent-blue: #3b82f6;
        }

        body {
            background-color: var(--bg-dark);
            color: #f1f5f9;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            overflow-x: hidden;
            min-height: 100vh;
        }

        /* Стилізація кастомного скролбара */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: var(--bg-dark);
        }
        ::-webkit-scrollbar-thumb {
            background: #1e293b;
            border-radius: 4px;
            border: 1px solid var(--border-color);
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #334155;
        }

        /* Картки та Glassmorphism */
        .stat-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            height: 100%;
            transition: border-color 0.2s ease;
        }
        .stat-card:hover {
            border-color: rgba(255, 255, 255, 0.15);
        }

        /* Адаптивна таблиця */
        .table-responsive {
            border-radius: 12px;
            border: 1px solid var(--border-color);
            background: var(--card-bg);
        }

        .custom-table {
            color: #cbd5e1;
            margin-bottom: 0;
        }
        .custom-table th {
            background-color: rgba(255, 255, 255, 0.03);
            border-bottom: 1px solid var(--border-color);
            color: #94a3b8;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 1rem;
        }
        .custom-table td {
            border-bottom: 1px solid var(--border-color);
            padding: 1rem;
            vertical-align: middle;
        }
        .custom-table tr:last-child td {
            border-bottom: none;
        }

        /* Кнопка градієнту */
        .btn-gradient {
            background: linear-gradient(135deg, var(--accent-blue) 0%, var(--accent-purple) 100%);
            border: none;
            color: white;
            box-shadow: 0 4px 15px rgba(139, 92, 246, 0.25);
            transition: all 0.2s ease;
        }
        .btn-gradient:hover {
            color: white;
            opacity: 0.95;
            transform: translateY(-1px);
        }

        /* Адаптивність для мобільних пристроїв (екранування @@media) */
        @@media (max-width: 576px) {
            .header-title {
                font-size: 1.25rem;
            }
            .stat-card {
                padding: 1rem !important;
            }
            .action-btns {
                flex-direction: column;
                width: 100%;
            }
            .action-btns .btn {
                width: 100%;
            }
        }
    </style>
</head>
<body>

    <!-- Шапка (Header) -->
    <nav class="navbar navbar-dark border-bottom border-secondary border-opacity-10 py-3">
        <div class="container-fluid px-3 px-md-4">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-primary fs-5" href="/Admin/Index">
                <i class="bi bi-shield-lock-fill"></i> Admin<span class="text-white">Console</span>
            </a>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2 py-1 small">
                    <i class="bi bi-circle-fill me-1" style="font-size: 6px;"></i> System Active
                </span>
                <a href="/Admin/Logout" class="btn btn-outline-danger btn-sm rounded-2">
                    <i class="bi bi-box-arrow-right"></i> <span class="d-none d-sm-inline">Вийти</span>
                </a>
            </div>
        </div>
    </nav>

    <!-- Основний контент -->
    <main class="container-fluid px-3 px-md-4 py-4">

        <!-- Заголовок і Дії -->
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
            <div>
                <h2 class="fw-bold mb-1 header-title text-white">Панель Управління Проєктом</h2>
                <p class="text-muted small mb-0">Моніторинг сервісів, REST API та керування товарним складом</p>
            </div>
            <div class="d-flex align-items-center gap-2 action-btns">
                <a href="/Admin/CreateProduct" class="btn btn-gradient fw-semibold rounded-3 px-3 py-2">
                    <i class="bi bi-plus-lg me-1"></i> Додати товар
                </a>
                <button onclick="location.reload();" class="btn btn-outline-secondary rounded-3 py-2 px-3">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
        </div>

        <!-- Сітка виджетів стану -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card p-3 p-md-4">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small">Модуль ServerApp</span>
                        <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-2">
                            <i class="bi bi-database"></i>
                        </div>
                    </div>
                    <div class="fw-bold text-white fs-6">ServerApp (Бекенд)</div>
                    <span class="text-muted extra-small">Проект скомпільовано: Core</span>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card p-3 p-md-4">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small">Модуль ClientApp</span>
                        <div class="bg-info bg-opacity-10 text-info rounded-3 p-2">
                            <i class="bi bi-display"></i>
                        </div>
                    </div>
                    <div class="fw-bold text-white fs-6">ClientApp (Клієнт)</div>
                    <span class="text-muted extra-small">Frontend / REST API</span>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card p-3 p-md-4">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small">База даних</span>
                        <div class="bg-success bg-opacity-10 text-success rounded-3 p-2">
                            <i class="bi bi-server"></i>
                        </div>
                    </div>
                    <div class="fw-bold text-white fs-6">MySQL 9.0 (3307)</div>
                    <span class="text-muted extra-small">WarehouseDB Connected</span>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="stat-card p-3 p-md-4">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small">Час роботи</span>
                        <div class="bg-success bg-opacity-10 text-success rounded-3 p-2">
                            <i class="bi bi-clock-history"></i>
                        </div>
                    </div>
                    <div class="fw-bold text-white fs-6">Uptime: Active</div>
                    <span class="text-muted extra-small">Стабільний сервер</span>
                </div>
            </div>
        </div>

        <!-- Додаткова інформація (БД та Swagger) -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-lg-6">
                <div class="stat-card p-3 p-md-4">
                    <div class="d-flex align-items-center gap-2 fw-semibold text-white mb-2">
                        <i class="bi bi-database-gear text-primary"></i> Адміністрування БД
                    </div>
                    <p class="text-muted small mb-3">Швидкий доступ до баз даних, списку користувачів та операційних логів.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="#" class="btn btn-outline-primary btn-sm rounded-pill"><i class="bi bi-people me-1"></i> Користувачі та Ролі</a>
                        <a href="#" class="btn btn-outline-info btn-sm rounded-pill"><i class="bi bi-journal-text me-1"></i> Логи Операцій</a>
                    </div>
                </div>
            </div>
            
            <div class="col-12 col-lg-6">
                <div class="stat-card p-3 p-md-4">
                    <div class="d-flex align-items-center gap-2 fw-semibold text-white mb-2">
                        <i class="bi bi-code-slash text-info"></i> API & Swagger
                    </div>
                    <p class="text-muted small mb-1">API Base URL: <code class="text-info bg-dark px-2 py-1 rounded">http://localhost:5024/api/</code></p>
                    <p class="text-muted small mb-3">Формат даних: JSON / REST API</p>
                    <a href="/swagger" target="_blank" class="btn btn-info btn-sm text-dark fw-bold rounded-pill">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Swagger API Documentation
                    </a>
                </div>
            </div>
        </div>

        <!-- Таблиця товарів -->
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="fw-bold text-white mb-0"><i class="bi bi-boxes text-primary me-2"></i>Управління Товарами</h5>
            <span class="badge bg-secondary bg-opacity-20 text-muted rounded-pill px-3">Всього товарів: @(Model?.Count() ?? 0)</span>
        </div>

        <div class="table-responsive">
            <table class="table custom-table">
                <thead>
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th>Назва товару</th>
                        <th>Кількість</th>
                        <th>Базова ціна</th>
                        <th>Знижка</th>
                        <th>Кінцева ціна</th>
                        <th class="text-end">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-muted">#@item.Id</td>
                                <td class="fw-semibold text-white">@item.Name</td>
                                <td><span class="badge bg-info bg-opacity-10 text-info">@item.Quantity шт.</span></td>
                                <td>@item.Price.ToString("N2") ₴</td>
                                <td>
                                    @if (item.Discount > 0)
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning">-@item.Discount%</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0%</span>
                                    }
                                </td>
                                <td class="fw-bold text-success">@item.FinalPrice.ToString("N2") ₴</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="/Admin/Edit/@item.Id" class="btn btn-outline-warning rounded-2 me-1" title="Редагувати">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a href="/Admin/Delete/@item.Id" class="btn btn-outline-danger rounded-2" title="Видалити">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                Товари відсутні у базі даних
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
