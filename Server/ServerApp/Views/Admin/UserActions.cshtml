@model IEnumerable<ServerApp.Models.UserAction>
@{
    ViewData["Title"] = "Журнал дій";
}

<div class="container mt-4">
    <h2>Журнал дій користувачів</h2>
    <table class="table table-striped table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Користувач</th>
                <th>Дія</th>
                <th>Товар</th>
                <th>Дата</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@(item.Worker?.Name ?? item.Worker?.Username ?? "—")</td>
                        <td>@item.ActionType</td>
                        <td>@(item.Item?.Name ?? "—")</td>
                        <td>@item.ActionDate.ToString("g")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">Записи відсутні</td>
                </tr>
            }
        </tbody>
    </table>
</div>
