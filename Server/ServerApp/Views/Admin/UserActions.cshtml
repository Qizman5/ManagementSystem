@model IEnumerable<ServerApp.Models.UserAction>
@{
    ViewData["Title"] = "Журнал дій";
}

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h4 class="mb-0 fw-bold text-dark"><i class="bi bi-journal-text text-primary me-2"></i>Журнал дій користувачів</h4>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Користувач</th>
                        <th>Тип дії</th>
                        <th>Товар</th>
                        <th class="text-end pe-4">Дата та час</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-muted">#@item.Id</td>
                                <td class="fw-semibold">
                                    <i class="bi bi-person-circle text-secondary me-2"></i>@(item.Worker?.Name ?? item.Worker?.Username ?? "—")
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark rounded-pill px-3 py-2">@item.ActionType</span>
                                </td>
                                <td><i class="bi bi-box text-muted me-2"></i>@(item.Item?.Name ?? "—")</td>
                                <td class="text-end pe-4 text-muted"><i class="bi bi-calendar3 me-1"></i>@item.ActionDate.ToString("dd.MM.yyyy HH:mm")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                <i class="bi bi-folder2-open display-6 mb-2 d-block"></i>Записи в журналі відсутні
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
