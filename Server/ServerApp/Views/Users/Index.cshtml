@model IEnumerable<ServerApp.Models.Worker>
@{
    ViewData["Title"] = "Список користувачів - AdminConsole";
    Layout = null;
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Користувачі - AdminConsole</title>
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <style>
        :root {
            --bg-dark: #0b0f19;
            --card-bg: #131b2e;
            --border-color: rgba(255, 255, 255, 0.08);
            --accent-purple: #8b5cf6;
            --accent-blue: #3b82f6;
        }

        body {
            background-color: var(--bg-dark);
            color: #f1f5f9;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
        }

        .navbar-custom {
            background-color: #0d1322;
            border-bottom: 1px solid var(--border-color);
        }

        .table-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
            overflow: hidden;
        }

        .custom-table {
            color: #e2e8f0;
            margin-bottom: 0;
            vertical-align: middle;
        }

        .custom-table thead tr {
            background-color: rgba(15, 23, 42, 0.8);
            border-bottom: 1px solid var(--border-color);
        }

        .custom-table th {
            color: #94a3b8;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            padding: 1.1rem 1rem;
            font-weight: 700;
            border: none;
        }

        .custom-table td {
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
            padding: 1rem;
            background: transparent;
        }

        .custom-table tbody tr:hover td {
            background-color: rgba(255, 255, 255, 0.03);
        }

        .badge-role-admin {
            background-color: rgba(239, 68, 68, 0.15);
            color: #f87171;
            border: 1px solid rgba(239, 68, 68, 0.3);
            font-weight: 600;
            padding: 0.35em 0.75em;
            border-radius: 8px;
        }

        .badge-role-worker {
            background-color: rgba(59, 130, 246, 0.15);
            color: #60a5fa;
            border: 1px solid rgba(59, 130, 246, 0.3);
            font-weight: 600;
            padding: 0.35em 0.75em;
            border-radius: 8px;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom py-3 mb-4">
        <div class="container-fluid px-3 px-md-4">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-primary fs-5" href="/Admin">
                <i class="bi bi-arrow-left-circle-fill text-primary"></i> Повернутися до панелі
            </a>
            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm rounded-3 px-3">
                    <i class="bi bi-box-arrow-right me-1"></i> Вийти
                </button>
            </form>
        </div>
    </nav>

    <main class="container-fluid px-3 px-md-4">
        <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4">
            <div>
                <h3 class="fw-bold text-white mb-1 d-flex align-items-center gap-2">
                    <i class="bi bi-people-fill text-primary"></i> Список користувачів
                </h3>
                <p class="text-muted small mb-0">Зареєстровані працівники та адміністратори системи</p>
            </div>
            <div>
                <span class="badge bg-dark border border-secondary border-opacity-20 text-muted rounded-pill px-3 py-2 fs-6">
                    Всього в базі: <span class="text-white fw-bold">@(Model?.Count() ?? 0)</span>
                </span>
            </div>
        </div>

        <div class="table-card mb-5">
            <div class="table-responsive">
                <table class="table custom-table">
                    <thead>
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>ІМ'Я / ПІБ</th>
                            <th>ЛОГІН</th>
                            <th>EMAIL</th>
                            <th>РОЛЬ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var worker in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-muted font-monospace">#@worker.Id</td>
                                    <td class="fw-semibold text-white">@(worker.Name ?? worker.FullName ?? "—")</td>
                                    <td class="text-slate-300">@(worker.Username ?? "—")</td>
                                    <td class="text-slate-300">@worker.Email</td>
                                    <td>
                                        @if (worker.Role == "Admin")
                                        {
                                            <span class="badge badge-role-admin"><i class="bi bi-shield-lock-fill me-1"></i>Admin</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-role-worker"><i class="bi bi-person-badge-fill me-1"></i>Worker</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-people fs-1 d-block mb-2 text-secondary"></i>
                                    Користувачі відсутні у базі даних
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>

</body>
</html>
