@model IEnumerable<ServerApp.Models.Worker>
@{
    ViewData["Title"] = "Список користувачів";
    Layout = null;
    int index = 1;
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Користувачі - AdminConsole</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <style>
        :root {
            --bg-main: #0b0f19;
            --card-bg: #131b2e;
            --card-border: rgba(255, 255, 255, 0.08);
            --accent-blue: #3b82f6;
        }

        body {
            background-color: var(--bg-main);
            color: #f1f5f9;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
        }

        .navbar-custom {
            background: rgba(11, 15, 25, 0.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--card-border);
        }

        .glass-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 16px;
            padding: 1.75rem;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        }

        .table-custom {
            --bs-table-bg: transparent;
            --bs-table-color: #cbd5e1;
            margin-bottom: 0;
            border-color: var(--card-border);
        }

        .table-custom th {
            background-color: rgba(255, 255, 255, 0.03);
            color: #94a3b8;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 0.85rem 1rem;
        }

        .table-custom td {
            padding: 0.9rem 1rem;
            vertical-align: middle;
            background-color: transparent !important;
            color: #f1f5f9;
        }

        .badge-role-admin {
            background: rgba(239, 68, 68, 0.2);
            color: #f87171;
            border: 1px solid rgba(239, 68, 68, 0.3);
            padding: 0.3rem 0.75rem;
            border-radius: 20px;
        }

        .badge-role-worker {
            background: rgba(59, 130, 246, 0.2);
            color: #60a5fa;
            border: 1px solid rgba(59, 130, 246, 0.3);
            padding: 0.3rem 0.75rem;
            border-radius: 20px;
        }

        .badge-role-manager {
            background: rgba(16, 185, 129, 0.2);
            color: #34d399;
            border: 1px solid rgba(16, 185, 129, 0.3);
            padding: 0.3rem 0.75rem;
            border-radius: 20px;
        }

        .badge-role-supervisor {
            background: rgba(168, 85, 247, 0.2);
            color: #c084fc;
            border: 1px solid rgba(168, 85, 247, 0.3);
            padding: 0.3rem 0.75rem;
            border-radius: 20px;
        }

        .badge-count {
            background: rgba(255, 255, 255, 0.08);
            color: #94a3b8;
            font-size: 0.8rem;
            padding: 0.35rem 0.75rem;
            border-radius: 20px;
        }
    </style>
</head>
<body>

    <!-- Навігація -->
    <nav class="navbar navbar-dark navbar-custom px-4 py-2 mb-4">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-white fs-5" href="/Admin">
                <i class="bi bi-shield-check text-primary"></i>
                <span>Admin <span class="text-secondary fw-normal">Console</span></span>
            </a>
            <a href="/Admin/Index" class="btn btn-outline-light btn-sm rounded-2 px-3">
                <i class="bi bi-arrow-left me-1"></i> Назад до панелі
            </a>
        </div>
    </nav>

    <!-- Основна область -->
    <main class="container-fluid px-4">
        <div class="glass-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold mb-0 d-flex align-items-center gap-2 text-white">
                    <i class="bi bi-people text-primary"></i> Список користувачів системи
                </h3>
                <span class="badge badge-count">Всього: @(Model?.Count() ?? 0)</span>
            </div>

            <div class="table-responsive rounded-3">
                <table class="table table-custom align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>ІМ'Я</th>
                            <th>ЛОГІН / EMAIL</th>
                            <th>РОЛЬ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var user in Model)
                            {
                                string roleCss = user.Role switch
                                {
                                    "Admin" => "badge-role-admin",
                                    "Manager" => "badge-role-manager",
                                    "Supervisor" => "badge-role-supervisor",
                                    _ => "badge-role-worker"
                                };

                                string roleIcon = user.Role switch
                                {
                                    "Admin" => "bi-shield-lock",
                                    "Manager" => "bi-briefcase",
                                    "Supervisor" => "bi-eye",
                                    _ => "bi-person"
                                };

                                <tr>
                                    <!-- Чисті номери 1, 2, 3... -->
                                    <td class="text-secondary fw-bold">@(index++)</td>
                                    <td class="fw-semibold text-white">
                                        <i class="bi bi-person-circle text-secondary me-2"></i>
                                        @(string.IsNullOrEmpty(user.Name) ? user.Username : user.Name)
                                    </td>
                                    <td class="text-info">
                                        @(string.IsNullOrEmpty(user.Email) ? user.Username : user.Email)
                                    </td>
                                    <td>
                                        <span class="@roleCss small fw-semibold">
                                            <i class="bi @roleIcon me-1"></i>@(user.Role ?? "Worker")
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-5">
                                    <i class="bi bi-people fs-2 d-block mb-2 opacity-50"></i>
                                    <span>Користувачів не знайдено</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>

</body>
</html>
