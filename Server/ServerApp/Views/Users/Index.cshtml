@model IEnumerable<ServerApp.Models.User>
@{ ViewData["Title"] = "Користувачі"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3"><i class="bi bi-people me-2"></i>Користувачі системи</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i> Додати користувача</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0 align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Логін</th>
                    <th>ПІБ</th>
                    <th>Email</th>
                    <th>Роль</th>
                    <th class="text-end">Дії</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var user in Model) {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.Username</td>
                    <td class="fw-bold">@user.FullName</td>
                    <td>@user.Email</td>
                    <td><span class="badge bg-info">@user.Role</span></td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-warning me-1"><i class="bi bi-pencil"></i></a>
                        <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
