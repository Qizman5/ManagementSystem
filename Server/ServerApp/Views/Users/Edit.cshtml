@model ServerApp.Models.User
@{ ViewData["Title"] = "Редагування користувача"; }

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0">Редагувати користувача</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label">Логін</label>
                        <input asp-for="Username" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label">ПІБ</label>
                        <input asp-for="FullName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" type="email" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Role" class="form-label">Роль</label>
                        <select asp-for="Role" class="form-select">
                            <option value="Worker">Worker</option>
                            <option value="Manager">Manager</option>
                            <option value="Admin">Admin</option>
                        </select>
                    </div>
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
                        <button type="submit" class="btn btn-warning">Зберегти</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
