<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WMS Admin</title>

    <!-- Google Fonts, Bootstrap 5 та Bootstrap Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        * {
            box-sizing: border-box;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        }

        body {
            background-color: #F4F5F9;
            color: #1E1E2C;
            min-height: 100vh;
        }

        .wms-navbar {
            background: #FFFFFF;
            border-bottom: 1px solid #EAEAEF;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
            padding: 12px 0;
        }

        .logo-badge {
            background-color: #512BD4;
            color: #FFFFFF;
            font-weight: 700;
            font-size: 16px;
            padding: 6px 12px;
            border-radius: 8px;
            letter-spacing: 0.5px;
        }

        .nav-link {
            font-weight: 500;
            color: #555566 !important;
            padding: 8px 16px !important;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .nav-link:hover, .nav-link.active {
            color: #512BD4 !important;
            background-color: #F0EDFD;
        }

        .card {
            background: #FFFFFF;
            border-radius: 16px;
            border: none;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
            overflow: hidden;
        }

        .card-header {
            background-color: #FFFFFF;
            padding: 20px 24px;
            border-bottom: 1px solid #F0F0F5;
            font-weight: 600;
            font-size: 16px;
            color: #1E1E2C;
        }

        .table {
            margin-bottom: 0;
        }

        .table th {
            background-color: #FAFAFC;
            padding: 14px 24px;
            font-size: 13px;
            font-weight: 600;
            color: #666666;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid #F0F0F5;
        }

        .table td {
            padding: 16px 24px;
            font-size: 14px;
            color: #333333;
            border-bottom: 1px solid #F0F0F5;
            vertical-align: middle;
        }

        .btn-purple {
            background-color: #512BD4;
            color: #FFFFFF;
            border: none;
            font-weight: 600;
            border-radius: 8px;
            padding: 8px 16px;
        }

        .btn-purple:hover {
            background-color: #4020A8;
            color: #FFFFFF;
        }

        /* --- АДАПТИВНІСТЬ ДЛЯ РІЗНИХ ПРИСТРОЇВ --- */

        /* Великі ПК / Монітори (від 1200px і вище) */
        @@media screen and (min-width: 1200px) {
            .container, .container-fluid {
                max-width: 1400px;
            }
        }

        /* Ноутбуки та MacBook (від 992px до 1199px) */
        @@media screen and (max-width: 1199px) {
            .row {
                flex-direction: column;
            }
            .col-md-4, .col-md-8 {
                width: 100% !important;
                margin-bottom: 20px;
            }
        }

        /* Планшети та iPad (від 768px до 991px) */
        @@media screen and (max-width: 991px) {
            body {
                padding: 10px;
            }
            .card {
                margin-bottom: 15px;
            }
            h3.fw-bold {
                font-size: 1.5rem;
            }
        }

        /* Телефони та Android / iPhone (до 767px) */
        @@media screen and (max-width: 767px) {
            body {
                font-size: 14px;
            }
            .navbar-brand {
                font-size: 1.1rem;
            }
            .table-responsive {
                border: 0;
            }
            .btn {
                width: 100%;
                margin-bottom: 8px;
            }
            .login-card, .card {
                padding: 15px !important;
                border-radius: 10px;
            }
        }

        /* Спеціально для вузьких мобільних екранів в портретній орієнтації */
        @@media screen and (max-width: 576px) {
            .container {
                padding-left: 5px;
                padding-right: 5px;
            }
        }
    </style>
</head>
<body>

    <header>
        <nav class="navbar navbar-expand-lg wms-navbar mb-4">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-dark me-4" asp-controller="Items" asp-action="Index">
                    <span class="logo-badge">WMS</span>
                    <span>Admin</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Items" asp-action="Index">
                                <i class="bi bi-boxes me-1"></i> Товари
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Users" asp-action="Index">
                                <i class="bi bi-people me-1"></i> Користувачі
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="UserActions" asp-action="Index">
                                <i class="bi bi-journal-text me-1"></i> Операції
                            </a>
                        </li>

                        <!-- Кнопка адмінки відображається тільки для ролі Admin -->
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-bold text-primary" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-shield-lock me-1"></i> Адмінка
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm px-3 py-2 fw-semibold">
                                <i class="bi bi-box-arrow-right me-1"></i> Вийти
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container pb-5">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
