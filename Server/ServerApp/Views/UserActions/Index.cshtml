@model IEnumerable<ServerApp.Models.UserAction>
@{
    ViewData["Title"] = "Журнал дій користувачів";
    Layout = null;
    int index = 1;
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Журнал Операцій - AdminConsole</title>
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <style>
        :root {
            --bg-dark: #0b0f19;
            --card-bg: #131b2e;
            --border-color: rgba(255, 255, 255, 0.08);
            --accent-purple: #8b5cf6;
            --accent-blue: #3b82f6;
        }

        body {
            background-color: var(--bg-dark);
            color: #f1f5f9;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
        }

        .navbar-custom {
            background-color: #0d1322;
            border-bottom: 1px solid var(--border-color);
        }

        .table-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
            overflow: hidden;
        }

        .custom-table {
            color: #e2e8f0;
            margin-bottom: 0;
            vertical-align: middle;
        }

        .custom-table thead tr {
            background-color: rgba(15, 23, 42, 0.8);
            border-bottom: 1px solid var(--border-color);
        }

        .custom-table th {
            color: #94a3b8;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            padding: 1.1rem 1rem;
            font-weight: 700;
            border: none;
        }

        .custom-table td {
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
            padding: 1rem;
            background: transparent;
        }

        .custom-table tbody tr:hover td {
            background-color: rgba(255, 255, 255, 0.03);
        }

        .badge-count {
            background: rgba(255, 255, 255, 0.08);
            color: #94a3b8;
            font-size: 0.8rem;
            padding: 0.35rem 0.75rem;
            border-radius: 20px;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom py-3 mb-4">
        <div class="container-fluid px-3 px-md-4">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-white fs-5" href="/Admin">
                <i class="bi bi-shield-check text-primary"></i>
                <span>Admin <span class="text-secondary fw-normal">Console</span></span>
            </a>
            <div class="d-flex align-items-center gap-2">
                <a href="/Admin/Index" class="btn btn-outline-light btn-sm rounded-3 px-3 me-2">
                    <i class="bi bi-arrow-left me-1"></i> Назад до панелі
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-3 px-3">
                        <i class="bi bi-box-arrow-right me-1"></i> Вийти
                    </button>
                </form>
            </div>
        </div>
    </nav>

    <main class="container-fluid px-3 px-md-4">
        <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4">
            <div>
                <h3 class="fw-bold text-white mb-1 d-flex align-items-center gap-2">
                    <i class="bi bi-journal-text text-info"></i> Журнал дій користувачів
                </h3>
                <p class="text-muted small mb-0">Історія дій та руху товарів у системі</p>
            </div>
            <div>
                <span class="badge badge-count">Записів: @(Model?.Count() ?? 0)</span>
            </div>
        </div>

        <div class="table-card mb-5">
            <div class="table-responsive">
                <table class="table custom-table">
                    <thead>
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>КОРИСТУВАЧ</th>
                            <th>ТИП ДІЇ</th>
                            <th>ТОВАР</th>
                            <th class="pe-4">ДАТА ТА ЧАС</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var action in Model)
                            {
                                <tr>
                                    <!-- Нумерація чисто числами 1, 2, 3 без решітки # -->
                                    <td class="ps-4 text-secondary fw-bold">@(index++)</td>
                                    <td class="fw-semibold text-white">
                                        <i class="bi bi-person text-secondary me-1"></i> @(action.Worker?.Name ?? action.Worker?.Username ?? "System")
                                    </td>
                                    <!-- Простий чистий текст дії замість плашки/кнопки Take -->
                                    <td class="text-light fw-medium">
                                        @action.ActionType
                                    </td>
                                    <td class="text-info fw-semibold">
                                        @(action.Item?.Name ?? "—")
                                    </td>
                                    <td class="pe-4 text-secondary small">
                                        <i class="bi bi-clock me-1"></i> @action.ActionDate.ToString("dd.MM.yyyy HH:mm")
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                    Операції відсутні
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>

</body>
</html>
