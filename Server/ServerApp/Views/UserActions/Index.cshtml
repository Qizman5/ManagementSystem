@model IEnumerable<ServerApp.Models.UserAction>
@{ ViewData["Title"] = "Журнал операцій"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3"><i class="bi bi-journal-text me-2"></i>Журнал складських операцій</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Зареєструвати операцію</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover table-striped mb-0 align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Тип дії</th>
                    <th>Товар</th>
                    <th>Користувач</th>
                    <th>Кількість</th>
                    <th>Дата</th>
                    <th class="text-end">Дії</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var action in Model) {
                <tr>
                    <td>@action.Id</td>
                    <td>
                        <span class="badge @(action.ActionType == "Receipt" ? "bg-success" : "bg-danger")">
                            @action.ActionType
                        </span>
                    </td>
                    <td>@action.Item?.Name</td>
                    <td>@action.User?.FullName</td>
                    <td>@action.Quantity шт.</td>
                    <td>@action.ActionDate.ToString("g")</td>
                    <td class="text-end">
                        <a asp-action="Delete" asp-route-id="@action.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
