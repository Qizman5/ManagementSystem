@{
    ViewData["Title"] = "Доступ обмежено";
    Layout = null;
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>403 - Доступ обмежено</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
        body {
            background-color: #0b0f19;
            color: #f1f5f9;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', system-ui, sans-serif;
        }
        .error-card {
            background: #131b2e;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 2.5rem;
            max-width: 480px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }
    </style>
</head>
<body>
    <div class="error-card">
        <div class="mb-3 text-danger">
            <i class="bi bi-shield-slash display-1"></i>
        </div>
        <h3 class="fw-bold mb-2">Доступ обмежено</h3>
        <p class="text-secondary mb-4">У вас немає прав адміністратора для перегляду цієї сторінки. Ви авторизовані як звичайний працівник.</p>
        <a href="/Items" class="btn btn-primary px-4 py-2 rounded-2">
            <i class="bi bi-box-seam me-1"></i> Перейти до товарів
        </a>
    </div>
</body>
</html>
