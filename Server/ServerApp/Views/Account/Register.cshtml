@model ServerApp.Models.RegisterViewModel
@{
    ViewData["Title"] = "Створення акаунту";
    Layout = null;
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Реєстрація - WMS System</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <style>
        :root {
            --bg-dark: #0b0f19;
            --card-bg: #131b2e;
            --border-color: rgba(255, 255, 255, 0.08);
            --accent-blue: #3b82f6;
        }

        body {
            background-color: var(--bg-dark);
            color: #f1f5f9;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .glass-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
            width: 100%;
            max-width: 480px;
        }

        .form-control {
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-color);
            color: #f1f5f9;
            border-top-right-radius: 8px;
            border-bottom-right-radius: 8px;
        }

        .form-control:focus {
            background-color: rgba(255, 255, 255, 0.08);
            border-color: var(--accent-blue);
            color: #fff;
            box-shadow: 0 0 0 0.25rem rgba(59, 130, 246, 0.25);
        }

        .input-group-text {
            background-color: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border-color);
            border-right: none;
            color: #94a3b8;
            border-top-left-radius: 8px;
            border-bottom-left-radius: 8px;
        }

        .btn-primary-custom {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            border: none;
            color: #fff;
            box-shadow: 0 4px 15px rgba(59, 130, 246, 0.3);
            transition: all 0.2s ease;
        }

        .btn-primary-custom:hover {
            opacity: 0.95;
            transform: translateY(-1px);
        }

        .password-hint {
            font-size: 0.75rem;
            color: #94a3b8;
            margin-top: 0.35rem;
        }
    </style>
</head>
<body class="py-4">
    <div class="container p-3">
        <div class="glass-card mx-auto p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex p-3 mb-2">
                    <i class="bi bi-person-plus-fill fs-2"></i>
                </div>
                <h3 class="fw-bold text-white mb-1">Створення акаунту</h3>
                <p class="text-secondary small">Зареєструйтесь для доступу до складської системи</p>
            </div>

            <form asp-controller="Account" asp-action="Register" method="post" autocomplete="off">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-danger py-2 mb-3" role="alert">
                        <div asp-validation-summary="All" class="small"></div>
                    </div>
                }

                <!-- Повне ім'я -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label text-secondary small fw-semibold">Повне ім'я</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-card-heading"></i></span>
                        <input asp-for="Name" class="form-control py-2" placeholder="Введіть ім'я" required autofocus />
                    </div>
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <!-- Логін -->
                <div class="mb-3">
                    <label asp-for="Username" class="form-label text-secondary small fw-semibold">Логін</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input asp-for="Username" class="form-control py-2" placeholder="Введіть логін" required />
                    </div>
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label text-secondary small fw-semibold">Електронна пошта</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" type="email" class="form-control py-2" placeholder="example@gmail.com" required />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <!-- Пароль -->
                <div class="mb-3">
                    <label asp-for="Password" class="form-label text-secondary small fw-semibold">Пароль</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" type="password" class="form-control py-2" placeholder="Введіть пароль" required />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                    <div class="password-hint">
                        <i class="bi bi-shield-lock me-1"></i> Мін. 8 символів:
                    </div>
                </div>

                <!-- Підтвердження пароля -->
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label text-secondary small fw-semibold">Підтвердження пароля</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-check2-circle"></i></span>
                        <input asp-for="ConfirmPassword" type="password" class="form-control py-2" placeholder="Повторіть пароль" required />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary-custom w-100 fw-bold py-2.5 rounded-3 mb-3">
                    <i class="bi bi-check-lg me-1"></i> Зареєструватися
                </button>

                <div class="text-center pt-3 border-top border-secondary border-opacity-25">
                    <span class="text-secondary small">Вже є акаунт?</span>
                    <a asp-controller="Account" asp-action="Login" class="fw-bold text-primary text-decoration-none ms-1">
                        Увійти
                    </a>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
