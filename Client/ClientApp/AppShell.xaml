<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="ClientApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ClientApp.Views"
    Title="WMS Mobile"
    FlyoutBehavior="Flyout">

    <!-- 1. Вхід / Авторизація (Стартова сторінка) -->
    <FlyoutItem Title="Авторизація">
        <ShellContent
            Title="Авторизація"
            ContentTemplate="{DataTemplate views:LoginPage}"
            Route="LoginPage" />
    </FlyoutItem>

    <!-- 2. Список товарів (Захищена сторінка) -->
    <FlyoutItem Title="Список товарів">
        <ShellContent
            Title="Список товарів"
            ContentTemplate="{DataTemplate views:ItemsPage}"
            Route="ItemsPage" />
    </FlyoutItem>

    <!-- 3. Створення операції (Захищена сторінка) -->
    <FlyoutItem Title="Створити операцію">
        <ShellContent
            Title="Створити операцію"
            ContentTemplate="{DataTemplate views:CreateOperationPage}"
            Route="CreateOperationPage" />
    </FlyoutItem>

    <!-- Кнопка виходу внизу бічного меню -->
    <MenuItem Text="🚪 Вийти з акаунту" Clicked="OnLogoutClicked" />

</Shell>
