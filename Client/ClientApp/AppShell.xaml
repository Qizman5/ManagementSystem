<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="ClientApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ClientApp.Views"
    Title="WMS Mobile">

    <!-- Головна сторінка авторизації -->
    <ShellContent
        Title="Логін"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <!-- Вкладка/Маршрут для списку товарів -->
    <ShellContent
        Title="Товари"
        ContentTemplate="{DataTemplate views:ItemsPage}"
        Route="ItemsPage" />

    <!-- Вкладка/Маршрут для створення операцій -->
    <ShellContent
        Title="Нова операція"
        ContentTemplate="{DataTemplate views:ActionPage}"
        Route="ActionPage" />

</Shell>