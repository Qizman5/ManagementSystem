<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="ClientApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ClientApp.Views"
    Title="WMS Mobile">

    <ShellContent
        Title="Авторизація"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <ShellContent
        Title="Список товарів"
        ContentTemplate="{DataTemplate views:ItemsPage}"
        Route="ItemsPage" />

    <ShellContent
        Title="Створення операції"
        ContentTemplate="{DataTemplate views:CreateOperationPage}"
        Route="CreateOperationPage" />

</Shell>
