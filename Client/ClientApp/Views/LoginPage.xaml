<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClientApp.Views.LoginPage"
             Title="Авторизація"
             BackgroundColor="#F4F5F9">

    <ScrollView VerticalOptions="Center">
        <VerticalStackLayout Padding="30" Spacing="18" MaximumWidthRequest="400" HorizontalOptions="Center">
            
            <!-- Логотип WMS -->
            <Border BackgroundColor="#512BD4" 
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20" 
                    HeightRequest="72" 
                    WidthRequest="72" 
                    HorizontalOptions="Center" 
                    Margin="0,0,0,10">
                <Label Text="WMS" 
                       TextColor="White" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" />
            </Border>

            <Label Text="Ласкаво просимо" 
                   FontSize="26" 
                   FontAttributes="Bold" 
                   TextColor="#1E1E2C"
                   HorizontalOptions="Center" />

            <Label Text="Увійдіть для доступу до системи" 
                   FontSize="14" 
                   TextColor="#6E6E82" 
                   HorizontalOptions="Center" 
                   Margin="0,-10,0,10" />

            <!-- Поле Email -->
            <Border Stroke="#E2E8F0" 
                    StrokeThickness="1" 
                    StrokeShape="RoundRectangle 10" 
                    BackgroundColor="White" 
                    Padding="12,0" 
                    HeightRequest="48">
                <Entry Placeholder="Email адреса" 
                       Text="{Binding Email, Mode=TwoWay, UpdateSourceEventName=TextChanged}" 
                       Keyboard="Email" 
                       TextColor="#1E1E2C"
                       PlaceholderColor="#A0A0B0"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center" />
            </Border>

            <!-- Поле Пароль -->
            <Border Stroke="#E2E8F0" 
                    StrokeThickness="1" 
                    StrokeShape="RoundRectangle 10" 
                    BackgroundColor="White" 
                    Padding="12,0" 
                    HeightRequest="48">
                <Entry Placeholder="Пароль" 
                       Text="{Binding Password, Mode=TwoWay, UpdateSourceEventName=TextChanged}" 
                       IsPassword="True" 
                       TextColor="#1E1E2C"
                       PlaceholderColor="#A0A0B0"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center" />
            </Border>

            <!-- Повідомлення про помилку -->
            <Label Text="{Binding ErrorMessage}" 
                   TextColor="#E53935" 
                   FontSize="13"
                   HorizontalOptions="Center" />

            <!-- Кнопка Увійти -->
            <Button Text="Увійти" 
                    Command="{Binding LoginCommand}" 
                    Clicked="OnLoginButtonClicked"
                    BackgroundColor="#512BD4" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="10"
                    HeightRequest="50"
                    Margin="0,8,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
