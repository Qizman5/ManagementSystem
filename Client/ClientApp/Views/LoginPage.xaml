<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClientApp.Views.LoginPage"
             Title="Авторизація"
             BackgroundColor="#F4F5F9">

    <ScrollView VerticalOptions="Center">
        <VerticalStackLayout Padding="30" Spacing="20" MaximumWidthRequest="450" HorizontalOptions="Center">
            
            <!-- Логотип / Іконка -->
            <Border BackgroundColor="#512BD4" 
                    StrokeShape="RoundRectangle 24" 
                    HeightRequest="80" 
                    WidthRequest="80" 
                    HorizontalOptions="Center" 
                    Margin="0,0,0,10">
                <Label Text="WMS" 
                       TextColor="White" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" />
            </Border>

            <Label Text="Ласкаво просимо" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   TextColor="#1E1E2C"
                   HorizontalOptions="Center" />

            <Label Text="Увійдіть для доступу до системи" 
                   FontSize="14" 
                   TextColor="#6E6E82" 
                   HorizontalOptions="Center" 
                   Margin="0,-10,0,10" />

            <!-- Поле Email -->
            <Border Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="15,2">
                <Entry Placeholder="Email адреса" 
                       Text="{Binding Email, Mode=TwoWay, UpdateSourceEventName=TextChanged}" 
                       Keyboard="Email" 
                       TextColor="#1E1E2C"
                       PlaceholderColor="#A0A0B0" />
            </Border>
            
            <!-- Поле Пароль -->
            <Border Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="15,2">
                <Entry Placeholder="Пароль" 
                       Text="{Binding Password, Mode=TwoWay, UpdateSourceEventName=TextChanged}" 
                       IsPassword="True" 
                       TextColor="#1E1E2C"
                       PlaceholderColor="#A0A0B0" />
            </Border>

            <Label Text="{Binding ErrorMessage}" 
                   TextColor="#E53935" 
                   FontSize="13"
                   HorizontalOptions="Center" 
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}" />

            <!-- Кнопка Входу -->
            <Button Text="Увійти" 
                    Command="{Binding LoginCommand}" 
                    Clicked="OnLoginButtonClicked"
                    BackgroundColor="#512BD4" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="12"
                    HeightRequest="52"
                    Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
