<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClientApp.Views.RegisterPage"
             Title="Реєстрація"
             BackgroundColor="#F4F5F9">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">

            <!-- Логотип WMS -->
            <Border StrokeShape="RoundRectangle 20"
                    BackgroundColor="#512BD4"
                    HeightRequest="70"
                    WidthRequest="70"
                    HorizontalOptions="Center"
                    StrokeThickness="0">
                <Label Text="WMS"
                       TextColor="White"
                       FontAttributes="Bold"
                       FontSize="18"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <Label Text="Реєстрація"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#1E1E2C"
                   HorizontalOptions="Center" />

            <Label Text="Створіть новий обліковий запис"
                   FontSize="14"
                   TextColor="#666666"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10" />

            <!-- Email -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Email:" FontAttributes="Bold" TextColor="#333333" />
                <Border StrokeShape="RoundRectangle 8" Stroke="#E0E0E0" Padding="8,0">
                    <Entry x:Name="RegEmailEntry"
                           Placeholder="example@gmail.com"
                           Keyboard="Email" />
                </Border>
            </VerticalStackLayout>

            <!-- Пароль -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Пароль:" FontAttributes="Bold" TextColor="#333333" />
                <Border StrokeShape="RoundRectangle 8" Stroke="#E0E0E0" Padding="8,0">
                    <Entry x:Name="RegPasswordEntry"
                           IsPassword="True"
                           Placeholder="••••••••••••" />
                </Border>
            </VerticalStackLayout>

            <!-- Підтвердження пароля -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Підтвердіть пароль:" FontAttributes="Bold" TextColor="#333333" />
                <Border StrokeShape="RoundRectangle 8" Stroke="#E0E0E0" Padding="8,0">
                    <Entry x:Name="ConfirmPasswordEntry"
                           IsPassword="True"
                           Placeholder="••••••••••••" />
                </Border>
            </VerticalStackLayout>

            <!-- Кнопка Реєстрація -->
            <Button Text="Зареєструватися"
                    Clicked="OnRegisterClicked"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="48"
                    Margin="0,15,0,0" />

            <!-- Перехід назад на Увійти -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,10,0,0">
                <Label Text="Вже є акаунт?" TextColor="#666666" VerticalOptions="Center" />
                <Button Text="Увійти"
                        Clicked="OnLoginRedirectClicked"
                        BackgroundColor="Transparent"
                        TextColor="#512BD4"
                        FontAttributes="Bold"
                        Padding="0" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
