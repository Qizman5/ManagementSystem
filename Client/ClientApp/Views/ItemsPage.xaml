<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ClientApp.Models"
             x:Class="ClientApp.Views.ItemsPage"
             Title="Список товарів"
             BackgroundColor="#F4F5F9">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20" RowSpacing="15">
        
        <!-- Кнопка Оновити -->
        <Button Grid.Row="0" 
                Text="↻  Оновити список" 
                Command="{Binding LoadItemsCommand}" 
                BackgroundColor="#E8EAF6"
                TextColor="#3F51B5"
                FontAttributes="Bold"
                FontSize="15"
                CornerRadius="10"
                HeightRequest="44" />

        <!-- Список товарів та складських операцій -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Items}">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                    <Label Text="📦" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="Товари відсутні або завантажуються..." TextColor="#757575" FontSize="16" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Item">
                    <Border Margin="0,6" 
                            Padding="16" 
                            StrokeShape="RoundRectangle 14" 
                            StrokeThickness="0" 
                            BackgroundColor="White">
                        <Border.Shadow>
                            <Shadow Brush="#10000000" Offset="0,4" Radius="8" />
                        </Border.Shadow>
                        
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                            <!-- ID та Назва товару -->
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6">
                                <Label Text="{Binding Id, StringFormat='[ID: {0}]'}" 
                                       FontSize="15" 
                                       FontAttributes="Bold" 
                                       TextColor="#6B7280" />
                                <Label Text="{Binding Name}" 
                                       FontSize="17" 
                                       FontAttributes="Bold" 
                                       TextColor="#1E1E2C" />
                            </HorizontalStackLayout>

                            <!-- Кількість -->
                            <Border Grid.Row="0" Grid.Column="1" 
                                    BackgroundColor="#E8F5E9" 
                                    StrokeShape="RoundRectangle 6" 
                                    Padding="8,2">
                                <Label Text="{Binding Quantity, StringFormat='К-сть: {0}'}" 
                                       FontSize="12" 
                                       TextColor="#2E7D32" 
                                       FontAttributes="Bold" />
                            </Border>

                            <!-- Тип операції -->
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6" Margin="0,8,0,0">
                                <Label Text="Тип операції:" FontSize="13" TextColor="#757575" />
                                <Label Text="{Binding OperationType}" 
                                       FontSize="13" 
                                       TextColor="#1565C0" 
                                       FontAttributes="Bold" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Кнопка Нова операція -->
        <Button Grid.Row="2" 
                Text="+  Створити нову операцію" 
                Clicked="OnCreateOperationClicked"
                BackgroundColor="#512BD4" 
                TextColor="White" 
                FontAttributes="Bold"
                FontSize="16"
                CornerRadius="12"
                HeightRequest="52" />
    </Grid>
</ContentPage>
