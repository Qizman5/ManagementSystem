<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ClientApp.Models"
             x:Class="ClientApp.Views.ItemsPage"
             Title="Список товарів"
             BackgroundColor="#F4F5F9">

    <!-- Кнопка Вийти у верхньому правому кутку шапки -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="🚪 Вийти" Clicked="OnLogoutClicked" Priority="0" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="16" RowSpacing="12">

        <!-- Заголовок -->
        <Label Grid.Row="0" 
               Text="Список товарів" 
               FontSize="22" 
               FontAttributes="Bold" 
               TextColor="#1E1E2C" />

        <!-- Кнопка Оновити список зверху -->
        <Button Grid.Row="1" 
                Text="🔄 Оновити список" 
                Command="{Binding LoadItemsCommand}" 
                BackgroundColor="#E8EAF6" 
                TextColor="#3F51B5" 
                FontAttributes="Bold" 
                CornerRadius="8" 
                HeightRequest="40" />

        <!-- Список товарів -->
        <RefreshView Grid.Row="2" 
                     IsRefreshing="{Binding IsBusy}" 
                     Command="{Binding LoadItemsCommand}">
            
            <CollectionView ItemsSource="{Binding Items}" 
                            EmptyView="Товари відсутні або завантажуються...">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Item">
                        <Frame Margin="0,4" 
                               Padding="14" 
                               BackgroundColor="White" 
                               CornerRadius="10" 
                               HasShadow="False" 
                               BorderColor="#E0E0E0">
                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="4">
                                <Label Grid.Row="0" Grid.Column="0" 
                                       Text="{Binding Name, StringFormat='[ID: {0}] {1}'}" 
                                       FontAttributes="Bold" 
                                       TextColor="#212121" 
                                       FontSize="14" />
                                
                                <Frame Grid.Row="0" Grid.Column="1" 
                                       BackgroundColor="#E8F5E9" 
                                       CornerRadius="6" 
                                       Padding="6,2" 
                                       HasShadow="False">
                                    <Label Text="{Binding Quantity, StringFormat='К-сть: {0}'}" 
                                           TextColor="#2E7D32" 
                                           FontSize="11" 
                                           FontAttributes="Bold" />
                                </Frame>

                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                                       Text="Тип операції: Прихід (Прибуття)" 
                                       TextColor="#1565C0" 
                                       FontSize="12" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Кнопка створити операцію внизу -->
        <Button Grid.Row="3" 
                Text="+ Створити нову операцію" 
                Clicked="OnCreateOperationClicked" 
                BackgroundColor="#512BD4" 
                TextColor="White" 
                FontAttributes="Bold" 
                CornerRadius="10" 
                HeightRequest="50" />

    </Grid>
</ContentPage>
