<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClientApp.Views.CreateOperationPage"
             Title="Створення операції">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Назва товару" FontAttributes="Bold" />
            <Entry x:Name="ItemNameEntry" Placeholder="Введіть назву товару" />

            <Label Text="Тип операції" FontAttributes="Bold" />
            <Picker x:Name="OperationTypePicker" Title="Оберіть тип">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Прихід (Income)</x:String>
                        <x:String>Витрата (Expense)</x:String>
                        <x:String>Переміщення (Transfer)</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Label Text="Кількість" FontAttributes="Bold" />
            <Entry x:Name="QuantityEntry" 
                   Keyboard="Numeric" 
                   Placeholder="Введіть кількість" 
                   TextChanged="OnNumericEntryTextChanged" />

            <Label Text="Примітка" FontAttributes="Bold" />
            <Entry x:Name="NoteEntry" Placeholder="Введіть примітку (необов'язково)" />

            <Button Text="Зберегти операцію" 
                    Margin="0,20,0,0" 
                    Clicked="OnSaveOperationClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
