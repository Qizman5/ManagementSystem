<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClientApp.Views.CreateOperationPage"
             Title="Створення операції"
             BackgroundColor="#F4F5F9">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Створення складської операції" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   TextColor="#1E1E2C" 
                   HorizontalOptions="Center" />

            <!-- Тип операції -->
            <Label Text="Тип операції:" FontSize="14" FontAttributes="Bold" TextColor="#757575" />
            <Picker x:Name="OperationTypePicker" 
                    Title="Оберіть тип операції"
                    BackgroundColor="White">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Прихід (Прибуття)</x:String>
                        <x:String>Витрата (Відвантаження)</x:String>
                        <x:String>Переміщення</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <!-- Назва товару (замінено з Entry на Picker) -->
            <Label Text="Назва товару:" FontSize="14" FontAttributes="Bold" TextColor="#757575" />
            <Picker x:Name="ItemPicker" 
                    Title="Оберіть товар зі списку" 
                    ItemDisplayBinding="{Binding Name}"
                    BackgroundColor="White" />

            <!-- Кількість -->
            <Label Text="Кількість:" FontSize="14" FontAttributes="Bold" TextColor="#757575" />
            <Entry x:Name="QuantityEntry" 
                   Placeholder="Введіть кількість" 
                   Keyboard="Numeric" 
                   BackgroundColor="White" />

            <!-- Примітка -->
            <Label Text="Примітка:" FontSize="14" FontAttributes="Bold" TextColor="#757575" />
            <Entry x:Name="NoteEntry" 
                   Placeholder="Додайте примітку (необов'язково)" 
                   BackgroundColor="White" />

            <!-- Кнопка збереження -->
            <Button Text="Зберегти операцію" 
                    Clicked="OnSaveOperationClicked" 
                    BackgroundColor="#2E7D32" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    CornerRadius="10" 
                    HeightRequest="50" 
                    Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
