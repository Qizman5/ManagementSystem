<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClientApp.Views.CreateOperationPage"
             Title="Створення операції"
             BackgroundColor="#F4F5F9">

    <ScrollView VerticalOptions="Center">
        <VerticalStackLayout Padding="25" Spacing="18" MaximumWidthRequest="500" HorizontalOptions="Center">
            
            <Label Text="Нова складська операція" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="#1E1E2C" />

            <!-- Вибір типу операції -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Тип операції:" TextColor="#555" FontAttributes="Bold" FontSize="13" />
                <Border Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="White" Padding="10,0">
                    <Picker Title="Оберіть тип операції" TextColor="#1E1E2C">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Прихід на склад</x:String>
                                <x:String>Списання / Відвантаження</x:String>
                                <x:String>Переміщення</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </Border>
            </VerticalStackLayout>

            <!-- Поле ID Товару з захистом від від'ємних значень -->
            <VerticalStackLayout Spacing="6">
                <Label Text="ID Товару:" TextColor="#555" FontAttributes="Bold" FontSize="13" />
                <Border Stroke="#E0E0E0" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="White" Padding="12,2">
                    <Entry Text="{Binding ProductId, Mode=TwoWay, UpdateSourceEventName=TextChanged}" 
                           Placeholder="Введіть додатний ID" 
                           Keyboard="Numeric" 
                           TextChanged="OnNumericEntryTextChanged"
                           TextColor="#1E1E2C" />
                </Border>
            </VerticalStackLayout>

            <!-- Повідомлення стану -->
            <Label Text="{Binding Message}" 
                   TextColor="#E53935" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" />

            <!-- Кнопка Зберегти -->
            <Button Text="Зберегти операцію" 
                    Command="{Binding CreateActionCommand}"
                    Clicked="OnSaveOperationClicked"
                    BackgroundColor="#512BD4" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="12"
                    HeightRequest="52"
                    Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
