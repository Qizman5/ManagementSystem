<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ClientApp.ViewModels"
             x:Class="ClientApp.Views.ActionPage"
             Title="Нова операція">
    <BindingContext>
        <vm:ActionViewModel />
    </BindingContext>
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Створення складської операції" FontSize="20" FontAttributes="Bold" />
        <Entry Placeholder="ID Товару" Text="{Binding ProductId}" Keyboard="Numeric" />
        <Entry Placeholder="Статус" Text="{Binding Status}" />
        <Button Text="Відправити" Command="{Binding CreateActionCommand}" BackgroundColor="#1E88E5" TextColor="White" />
        <Label Text="{Binding Message}" TextColor="Green" HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>
