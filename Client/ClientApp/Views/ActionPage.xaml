<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClientApp.Views.ActionPage"
             Title="Створення операції">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Нова складська операція" FontSize="20" FontAttributes="Bold" />

            <Label Text="Тип операції:" />
            <Picker SelectedItem="{Binding ActionType}">
                <Picker.Items>
                    <x:String>Прихід</x:String>
                    <x:String>Витрата</x:String>
                </Picker.Items>
            </Picker>

            <Label Text="ID Товару:" />
            <Entry Text="{Binding ItemId}" Keyboard="Numeric" />

            <Label Text="Кількість:" />
            <Entry Text="{Binding Quantity}" Keyboard="Numeric" />

            <Button Text="Зберегти" Command="{Binding SaveActionCommand}" />

            <Label Text="{Binding StatusMessage}" TextColor="Green" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>